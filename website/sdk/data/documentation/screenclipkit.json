ivacy"},{"generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit"],"title":"Enumerations"}],"identifier":{"url":"doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit","interfaceLanguage":"swift"},"metadata":{"images":[{"identifier":"screenclip-icon.svg","type":"icon"}],"color":{"standardColorIdentifier":"orange"},"role":"collection","roleHeading":"Framework","externalID":"ScreenClipKit","title":"ScreenClipKit","symbolKind":"module","modules":[{"name":"ScreenClipKit"}]},"abstract":[{"text":"Report what you see in your own iOS app, straight into ScreenClip on your Mac, where a coding agent fixes it.","type":"text"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"ScreenClipKit is a small Swift package for the "},{"type":"strong","inlineContent":[{"text":"Debug","type":"text"}]},{"type":"text","text":" build of your iOS app. A tester shakes the device, or takes a screenshot and taps "},{"type":"strong","inlineContent":[{"text":"Report","type":"text"}]},{"type":"text","text":". They mark up the screen and add a note, then tap "},{"type":"strong","inlineContent":[{"text":"Send","type":"text"}]},{"type":"text","text":". The report goes over your local network, encrypted, to ScreenClip on the Mac you paired with. There it joins the same queue as captures made on the Mac. Your coding agent (Codex, Claude Code, or Grok Bot) works on it and opens a pull request. If the Mac isn’t reachable, the report waits on the device and is sent later."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"composer"}],"type":"paragraph"},{"code":["import SwiftUI","#if DEBUG","import ScreenClipKit","#endif","","@main","struct ShopApp: App {","  init() {","    #if DEBUG","    ScreenClipKit.start()","    #endif","  }","  var body: some Scen