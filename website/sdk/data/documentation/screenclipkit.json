{"metadata":{"symbolKind":"module","roleHeading":"Framework","externalID":"ScreenClipKit","modules":[{"name":"ScreenClipKit"}],"images":[{"identifier":"screenclip-icon.svg","type":"icon"}],"role":"collection","title":"ScreenClipKit","color":{"standardColorIdentifier":"orange"}},"abstract":[{"text":"Report what you see in your own iOS app, straight into ScreenClip on your Mac, where a coding agent fixes it.","type":"text"}],"variants":[{"paths":["\/documentation\/screenclipkit"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/GettingStarted","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/HowReportsWork","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/start(_:)","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipOptions"],"title":"Essentials"},{"anchor":"Triggers-and-your-own-debug-menu","identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipTrigger","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/start(triggers:)","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/capture()","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/showSettings()","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/isActive"],"title":"Triggers and your own debug menu"},{"anchor":"Attaching-your-own-data","identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/AttachingYourOwnFiles","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/setAttachmentProvider(_:timeout:_:)","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClip