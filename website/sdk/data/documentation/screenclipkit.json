{"kind":"symbol","metadata":{"symbolKind":"module","externalID":"ScreenClipKit","role":"collection","title":"ScreenClipKit","images":[{"type":"icon","identifier":"screenclip-icon.svg"}],"color":{"standardColorIdentifier":"orange"},"roleHeading":"Framework","modules":[{"name":"ScreenClipKit"}]},"abstract":[{"text":"Report what you see in your own iOS app, straight into ScreenClip on your Mac, where a coding agent fixes it.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/screenclipkit"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/GettingStarted","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/HowReportsWork","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/start(_:)","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipOptions"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipTrigger","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/start(triggers:)","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/capture()","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/showSettings()","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/isActive"],"anchor":"Triggers-and-your-own-debug-menu","title":"Triggers and your own debug menu"},{"identifiers":["doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/AttachingYourOwnFiles","doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/ScreenClipKit\/setAttachmentProvider(_:timeout: