mport ScreenClipKit","#endif","","@main","struct ShopApp: App {","  init() {","    #if DEBUG","    ScreenClipKit.start()","    #endif","  }","  var body: some Scene { WindowGroup { ContentView() } }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Release builds contain none of it. Outside Debug the package compiles to an empty stub with the same API, and your "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" guards keep the call out as well. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/PrivacyAndReleaseBuilds"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"New to ScreenClip? "},{"isActive":true,"type":"reference","identifier":"https:\/\/screenclipai.com\/ios"},{"type":"text","text":" shows the whole loop, and you can download ScreenClip for the Mac at "},{"isActive":true,"type":"reference","identifier":"https:\/\/screenclipai.com"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://com.mirageteam.screenclip.kit/documentation/ScreenClipKit/Diagnostics":{"abstract":[{"text":"The optional files ScreenClipKit attaches, and how the tester controls them.","type":"text"}],"kind":"article","type":"topic","title":"Diagnostics","role":"article","identifier":"doc:\/\/com.mirageteam.screenclip.kit\/documentation\/ScreenClipKit\/Diagnostics","url":"\/documentation\/screenclipkit\/diagnostics"},"doc://com.mirageteam.screenclip.kit/documentation/ScreenClipKit/ScreenClipKit/removeAttachmentProvider(_:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAttachmentProvider"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Stops adding the files from the provid