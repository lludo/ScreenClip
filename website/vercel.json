{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-OOaL01yASeoNMVajB9lCwhRL3zfitKp8fI5ifgA5GfA=' 'sha256-D+22vpS1dfr4mHtQdjgB7vfwHN44rXO5BdyXVpSOi2M=' 'sha256-QfJlNbnfSSsw3mykO7H8Az6GQF/EAIWLmzalhcwXsN0=' 'sha256-4xJo1ApKqNZQh7Y4hf5e7zG+4zEY+9caGyBeCS6EDW8=' 'sha256-N4AX5Jl51zoiWCfTR74ALp44MDZEs3wff8Pt7MveAo0=' 'sha256-ATLsGo4Z9Cj/JvVDwhJDJ9u8DnEhJjFpLS+2aD6HElc=' 'sha256-9Y046h/nbgzYBbvVpoG8G5G2rPTkoOVJ26+915QpkhY=' 'sha256-RvDzbtTiA7Ya4VYQo9dL0/ljz6TLRZ6mDS2pUYINrHQ=' 'sha256-NBiAQLQ0NL4aMRWFntyCcQg+sAcBcPo5R86qteG/aNw=' 'sha256-6EzkNP0QUODCsxY1fV3Csj4nDGy7yUX3ma3EbL6g2+E='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
