{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "ignoreCommand": "sh ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "cursor/**": false,
      "codex/**": false,
      "grokbot/**": false,
      "screenclip/**": false
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-7tcheHBzNtsn6imO6p7qJz9B0PqFSDtUN3pvjmUZTlc=' 'sha256-k1v5oQNFXb2nb9Ja+ijGxXfFUecAI13yD04kIXBJVTU=' 'sha256-NDFpjXH5WK1MEKIad69oGwzEYdiWgq2nkGWHSFKqgys=' 'sha256-VC1IAEykjG5jBXQ1ssSv6X1vg5s00m5T+d0vC689FGA=' 'sha256-e7kXzl5/trsItLVCuPzBSiFoYuZH4z5LDagN0ebqgCo=' 'sha256-1vID3QWGXsq4Vhzi3pLrqM2q4+rBwWWUQz8abZZgs+Y=' 'sha256-RoEuUJKCF1Br+yATdq2SC/lbAMDDGpg1Np2qCdiay4I=' 'sha256-I/RDTCDio/YLHehlVhrhZZqFeiCf1EzT/0SlR7Rt8go=' 'sha256-cVbFmqMK4y8quSBh3hc3s9tfSqMUY8Q8M0aGKjuGFtw=' 'sha256-9CvfdZOKyThmhnq+upQCT5gFqI9ZdM59lEk+0gBnXz8='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
