{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-OPW9mWlF/lfCo4xBppzaXtoN071O+pjESYJCkkqQ6OY=' 'sha256-ZrwsRYsivbfIBO/4H/+JNB6mrX0JFG94Fi3ZEOLloes=' 'sha256-qmg0yveoK8LHFj5LlckIS4Y2uHrBCE0sEbHzvUi2Zn0=' 'sha256-mNOgmhVmYC15bSmExip0duoxc+M244n/khQzSPS055c=' 'sha256-fdzjN6v0UEoxtx++rkuaf0BRs1k+JxEWGuoo0Irt80k=' 'sha256-oZ23jYy8w7CBQHr6LOeABAy64DS1F4PoIoeM91NBhXI=' 'sha256-4NOEbSIJt5PDNUoc5ydcKfnS1PLUX9tPkiIxR1t5RRA=' 'sha256-XelGt1wC5dxhT8r1izNbFJ1rYhwmph/GuBHpshEFr0Y=' 'sha256-6NYZbFrKv39iUXuZLtUxjR0Dqf/UnWuVuY3MYENv0dY=' 'sha256-TZ0MHxgw9FsL/na5Ix+I6jAK3xSkZQPQGd90BKRTX8g='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
