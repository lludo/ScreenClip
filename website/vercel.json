{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-WcMQxMPdjSbhixC35bxN+DphCyhggD1JOHWHmXg7GIg=' 'sha256-bJ+8GnytkpHZcZE9pQmq/pFWQFCjs6XqqwT7E3W4mFU=' 'sha256-s9+tyNsixZJ+QFHuQP8T2Sfoi6ZhHFb1zBBcPWRMzKw=' 'sha256-GVvuQid00EZJrSKZdhog2C6WXx9l7ukGzWdnqtQPENM=' 'sha256-umst74ONFGOOyyuUqe7MuIMUsyz1Bcsu23bwgQMGqsU=' 'sha256-W3U5jUSgcZPK1T+/e3Y3QIByxYmhVN73wMLcU9sxE1w=' 'sha256-a/RfypcWuifD7V68q8MlqfXvhTCC1qKLEQZsM8qgUn8=' 'sha256-7DRr0q3pvSQmZQuFD46btJIOL9FJL49wbKS5AF/9reg=' 'sha256-OopO7/kV8yLTSXQlBwEhKoj76HYTPqZ7JNtFridI1lw=' 'sha256-CvXQY6AAfXrnZ0L8y1OPPvgoDTV6Gh7NbWmHEcEgN8A='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
