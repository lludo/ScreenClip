{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-MUqYqNZvYWSFZ48+Qc3vufMk5uEMdclyeLPyozeAMo8=' 'sha256-BjajpICRDp+ldd03nldFphmquSf2z/HmsIoUDPmAfZI=' 'sha256-UjrGB35iyQPk1cKL/GdwTNcZVzIbDlya/ewDMTb6ClI=' 'sha256-Rw8sxNFzotP/uNWz7bdQBeoVVQymqbVGLo16CAxH6k4=' 'sha256-9ONf70oqPUaZoOq+VyrkZ9+PPY/p+jDJ28xfC2la5sM=' 'sha256-TNllOHEFjN8qPNvpe0YQHXO//9Uf8a4x/eCVYxBsASI=' 'sha256-Wa7Qw+jZ78Gt8Pz8liH+0ZuCgTo6gOa/UqEiuQkRpJo=' 'sha256-EW2S724NVlmcYqsX8TuwJwDOBFn59EVmUmEdNZdS/qw=' 'sha256-ZDdRouGjKBfzQpSbkvbhK+UC0uQevE+KryVsgonbTCc=' 'sha256-estMfpaxPhRCt2og3N8LKsifUQNuZ+r8/aK9AQvgPZ4='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
