{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-UQeN6PHbX24qXyLDtQZUKu6hhOAFauGhsV11ybtb5eY=' 'sha256-QCdPgWlBSNBmsj1j47eiv/A2oWJKdEbufdWI1aRUicQ=' 'sha256-/wRZKWVJogQNnl74YLaDJGnx15a11tkjGcf/NTDevJs=' 'sha256-ZmvvfWiNwpkO6GaZLP9rb3JfmecFOpDC+Loo0yAnzr4=' 'sha256-shEBHskiv7uy1cFi5FQMFDQHPnUjEEM3uBImlM8MLu0=' 'sha256-w2EUBIpwbtQzo9b7etAMXWp5dGOzOF8BMhL07n9jpws=' 'sha256-Jh8PCpswCVUJ8VlL21uAcrdzXCar6rhdSID57sqwBaM=' 'sha256-FrScZjgscwUprrlV5aJdYu6pbF7fQJ+CXkP9oAnAeIM=' 'sha256-PswePGomu8vbUzTxJW4UKxpwYhoZZmFMR1R3+Lvsm9g=' 'sha256-w2Ce0sBCDlzZxJDCzAojnExIiimVUqdv8lc0spR2XFA='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
