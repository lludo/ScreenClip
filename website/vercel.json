{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.screenclipai.com"
        }
      ],
      "destination": "https://screenclipai.com/:path*",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    },
    {
      "source": "/sdk/documentation",
      "destination": "/sdk/documentation/screenclipkit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-hXH1S10NgCN1LEMOBkI9Gnlr0ltGP311b3tiEWiGwTA=' 'sha256-UZQZIsbspyC1vAW/tgowJttM+AH5eNskClpXq1owgnA=' 'sha256-V6UPQ6SHyEEI1fYRv7WcLqOoO6cH+SMjSsQ733+Kauo=' 'sha256-ZmvvfWiNwpkO6GaZLP9rb3JfmecFOpDC+Loo0yAnzr4=' 'sha256-r+rXdKITS1Z7AdxBoy/NdNOGQhPbUZYZRdT8hFGE3xY=' 'sha256-oLJbafplmgugfb3NY+rVfuMvmmoDzENWlPAaChsomw4=' 'sha256-vemE0ulKgXwHpf1DqyqIGFaMXioOpUQmD6NxTywJXO0=' 'sha256-lWTVFDklBATKMn74sF/ydG6fxhAK3oPArPghcRrxyO8=' 'sha256-KQ3+PXSJkPBiQE4zlKqmMeSo1HC0MXCtxZcYyDQ7zs4=' 'sha256-LjAyWrEK4rAhx5NzJPDrDVVsxe5wRvrEJdPsQsYIITw='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/h/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sdk/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
