    "Describe what was not addressed or still looks wrong.": {
      "comment": "Follow-up note instructions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what was not addressed or still looks wrong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明哪些地方没处理好，或看起来仍不对。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que no se resolvió o lo que sigue viéndose mal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応されなかった点や、まだおかしく見える点を書いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que não foi tratado ou o que ainda parece errado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was nicht erledigt wurde oder noch falsch aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez ce qui n’a pas été traité ou qui semble encore incorrect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리되지 않았거나 아직 이상해 보이는 점을 적어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что не было сделано или всё ещё выглядит неправильно."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明哪些地方沒處理好，或看起來仍不對。"
          }
        }
      }
    },
    "Describe what was not addressed; the agent starts a new fix with your feedback.": {
      "comment": "Help for the follow-up button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what was not addressed; the agent starts a new fix with your feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明哪些地方没处理好；代理会根据你的反馈开始新的修复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que no se resolvió; el agente empieza una nueva corrección con tu comentario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応されなかった点を書くと、エージェントがそのフィードバックで新しい修正を始めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que não foi tratado; o agente inicia uma nova correção com o seu feedback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was fehlt; der Agent startet mit deinem Feedback einen neuen Fix."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez ce qui manque ; l’agent lance un nouveau correctif avec votre retour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리되지 않은 점을 적으면 에이전트가 그 피드백으로 새 수정을 시작합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что не сделано; агент начнёт новое исправление с вашим отзывом."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明哪些地方沒處理好；代理會根據你的回饋開始新的修復。"
          }
        }
      }
    },
    "Describe what you noticed or add details you missed when filing.": {
      "comment": "Additional context instructions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
