    "Sign-in did not finish. Check the connection if the browser showed an error, or try sign-in with a code.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in did not finish. Check the connection if the browser showed an error, or try sign-in with a code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录没有完成。如果浏览器显示错误，请检查连接，或改用代码登录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no terminó. Comprueba la conexión si el navegador mostró un error, o prueba a iniciar sesión con un código."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインが完了しませんでした。ブラウザにエラーが出た場合は接続を確認するか、コードでサインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
