    "Save this capture as a draft or discard it before quitting ScreenClip.": {
      "comment": "Alert when quitting is refused because a capture is open. Keep ScreenClip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this capture as a draft or discard it before quitting ScreenClip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 ScreenClip 前，请把这次捕获存为草稿或丢弃。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta captura como borrador o descártala antes de salir de ScreenClip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip を終了する前に、このキャプチャを下書きとして保存するか破棄してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve esta captura como rascunho ou descarte-a antes de encerrar o ScreenClip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere diese Aufnahme als Entwurf oder verwirf sie, bevor du ScreenClip beendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette capture comme brouillon ou abandonnez-la avant de quitter ScreenClip."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip을 종료하기 전에 이 캡처를 초안으로 저장하거나 버리세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед выходом из ScreenClip сохраните снимок как черновик или отбросьте его."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 ScreenClip 前，請把這次擷取存為草稿或捨棄。"
          }
        }
      }
    },
    "Save your capture as a draft before reopening ScreenClip.": {
