    "Notifications are disabled. Enable ScreenClip in System Settings to receive alerts.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled. Enable ScreenClip in System Settings to receive alerts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请在系统设置中启用 ScreenClip 以接收提醒。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Activa ScreenClip en Ajustes del Sistema para recibir avisos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はオフです。アラートを受け取るには、システム設定で ScreenClip を有効にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative o ScreenClip nos Ajustes do Sistema para receber alertas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Aktiviere ScreenClip in den Systemeinstellungen, um Hinweise zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Activez ScreenClip dans Réglages Système pour recevoir des alertes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 알림을 받으려면 시스템 설정에서 ScreenClip을 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены. Включите ScreenClip в Системных настройках, чтобы получать оповещения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。請在系統設定中啟用 ScreenClip 以接收提醒。"
          }
        }
      }
    },
