    "That keyboard shortcut is already in use. Choose another in Settings.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That keyboard shortcut is already in use. Choose another in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该键盘快捷键已被占用。请在设置中另选一个。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese atajo de teclado ya está en uso. Elige otro en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのキーボードショートカットは使用中です。設定で別のものを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse atalho de teclado já está em uso. Escolha outro em Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Tastaturkürzel ist schon belegt. Wähle in den Einstellungen ein anderes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci clavier est déjà utilisé. Choisissez-en un autre dans Réglages."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 키보드 단축키는 이미 사용 중입니다. 설정에서 다른 것을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш уже занято. Выберите другое в Настройках."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該鍵盤快速鍵已被占用。請在設定中另選一個。"
          }
        }
      }
    },
    "The Authorization header cannot contain a line break. Paste the single-line value from the Grok Bot routine panel.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Authorization header cannot contain a line break. Paste the single-line value from the Grok Bot routine panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization 标头不能包含换行。请从 Grok Bot 例程面板粘贴单行值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El encabezado Authorization no puede contener un salto de línea. Pega el valor de una sola línea del panel de la rutina de Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization ヘッダーに改行は含められません。Grok Bot のルーチンパネルから 1 行の値を貼り付けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cabeçalho Authorization não pode conter quebra de linha. Cole o valor de uma linha do painel da rotina do Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Authorization-Header darf keinen Zeilenumbruch enthalten. Füge den einzeiligen Wert aus dem Grok Bot-Routinenbereich ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’en-tête Authorization ne peut pas contenir de saut de ligne. Collez la valeur sur une seule ligne depuis le panneau de routine Grok Bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization 헤더에는 줄바꿈이 있으면 안 됩니다. Grok Bot 루틴 패널의 한 줄 값을 붙여 넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок Authorization не может содержать перевод строки. Вставьте однострочное значение из панели процедуры Grok Bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization 標頭不能包含換行。請從 Grok Bot 例程面板貼上單行值。"
          }
        }
      }
    },
    "The Grok Bot report has no evidence branch.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Grok Bot report has no evidence branch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份 Grok Bot 报告没有证据分支。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe de Grok Bot no tiene rama de evidencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Grok Bot レポートには証拠ブランチがありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório do Grok Bot não tem branch de evidência."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Grok Bot-Bericht hat keinen Evidenz-Branch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport Grok Bot n’a pas de branche de preuves."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Grok Bot 리포트에는 증거 브랜치가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У отчёта Grok Bot нет ветки с материалами."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份 Grok Bot 報告沒有證據分支。"
          }
        }
      }
    },
    "The PR changed; run validation again before merging.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PR changed; run validation again before merging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 已变化；合并前请再次运行验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PR cambió; vuelve a ejecutar la validación antes de fusionar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PR が変わったため、マージ前にもう一度検証してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PR mudou; execute a validação de novo antes do merge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PR hat sich geändert; führe die Validierung vor dem Merge erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La PR a changé ; relancez la validation avant de fusionner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PR이 바뀌었습니다. 병합 전에 검증을 다시 실행하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PR изменился; перед слиянием снова запустите проверку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 已變化；合併前請再次執行驗證。"
          }
        }
      }
    },
    "The browser sign-in did not complete. Check the connection or try another sign-in option.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser sign-in did not complete. Check the connection or try another sign-in option."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器登录没有完成。请检查连接或尝试其他登录方式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en el navegador no se completó. Comprueba la conexión o prueba otra opción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでのサインインが完了しませんでした。接続を確認するか、別の方法を試してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no navegador não foi concluído. Verifique a conexão ou tente outra opção."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browser-Anmeldung wurde nicht abgeschlossen. Prüfe die Verbindung oder wähle eine andere Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par navigateur ne s’est pas terminée. Vérifiez la connexion ou essayez une autre option."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인이 완료되지 않았습니다. 연결을 확인하거나 다른 방법을 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через браузер не завершился. Проверьте подключение или выберите другой способ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器登入沒有完成。請檢查連線或嘗試其他登入方式。"
          }
        }
      }
    },
