    "Reconnect and reconcile the chat; the original request may no longer be pending.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect and reconcile the chat; the original request may no longer be pending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新连接并核对聊天；原来的请求可能已不再等待。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar y reconcilia el chat; la solicitud original puede ya no estar pendiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続してチャットを照合してください。元のリクエストはもう保留中でないことがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte e reconcilie o chat; a solicitação original pode não estar mais pendente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich neu und gleiche den Chat ab; die ursprüngliche Anfrage ist vielleicht nicht mehr offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous et rapprochez le chat ; la demande d’origine n’est peut-être plus en attente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결하고 채팅을 맞추세요. 원래 요청은 더 이상 대기 중이 아닐 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь снова и сверьте чат; исходный запрос может уже не ожидать ответа."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新連線並核對聊天；原來的請求可能已不再等待。"
          }
        }
      }
    },
