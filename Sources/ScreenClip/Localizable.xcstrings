    "Related captures must use the issue's existing project.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Related captures must use the issue's existing project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关捕获必须使用该问题现有的项目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas relacionadas deben usar el proyecto existente del informe."
          }
