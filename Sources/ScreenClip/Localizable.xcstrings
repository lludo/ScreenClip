    "Approved annotated screenshots are pushed to a branch in the project's GitHub repo. A private repo is recommended.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved annotated screenshots are pushed to a branch in the project's GitHub repo. A private repo is recommended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准的带标注截图会推送到该项目 GitHub 仓库的一个分支。建议使用私有仓库。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas anotadas aprobadas se envían a una rama del repositorio de GitHub del proyecto. Se recomienda un repositorio privado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認された注釈付きスクリーンショットは、プロジェクトの GitHub リポジトリのブランチにプッシュされます。非公開リポジトリを推奨します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas anotadas aprovadas vão para um branch do repositório GitHub do projeto. Um repositório privado é recomendado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegebene, kommentierte Screenshots werden in einen Branch des GitHub-Repos des Projekts gepusht. Ein privates Repo ist empfehlenswert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures annotées approuvées sont poussées vers une branche du dépôt GitHub du projet. Un dépôt privé est recommandé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 주석 스크린샷은 프로젝트 GitHub 저장소의 브랜치로 푸시됩니다. 비공개 저장소를 권장합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобренные снимки с пометками отправляются в ветку репозитория GitHub проекта. Рекомендуется частный репозиторий."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已核准的帶標註截圖會推送到該專案 GitHub 倉庫的一個分支。建議使用私有倉庫。"
          }
        }
      }
    },
