    "activity.grokPickup": {
      "comment": "Activity when Grok Bot has not acknowledged a revision. %lld is the revision. Keep Grok Bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot hasn't picked up revision %lld yet (run may have failed or hit a rate limit). Continue resends it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot 还没有接收修订 %lld（运行可能失败或达到了速率限制）。继续会重新发送。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot todavía no ha recogido la revisión %lld (la ejecución puede haber fallado o alcanzado un límite). Continuar la reenvía."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot はリビジョン %lld をまだ受け取っていません（実行が失敗したか、レート制限の可能性があります）。続けると再送信します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Grok Bot ainda não recebeu a revisão %lld (a execução pode ter falhado ou atingido um limite). Continuar reenvia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot hat Revision %lld noch nicht übernommen (der Lauf kann fehlgeschlagen sein oder ein Limit erreicht haben). Weiter sendet erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot n’a pas encore pris la révision %lld (l’exécution a pu échouer ou atteindre une limite). Continuer la renvoie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot이 개정 %lld을(를) 아직 받지 않았습니다(실행이 실패했거나 한도에 걸렸을 수 있습니다). 계속하면 다시 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot ещё не принял ревизию %lld (запуск мог завершиться ошибкой или упереться в лимит). Продолжение отправит снова."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot 還沒有接收修訂 %lld（執行可能失敗或達到了速率限制）。繼續會重新傳送。"
          }
        }
      }
    },
