    "Merged code becomes visible after the relevant build or deployment. Your running app has not been restarted.": {
      "comment": "Shown after a fix merges, before the user retests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merged code becomes visible after the relevant build or deployment. Your running app has not been restarted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并的代码要在相应的构建或部署之后才会出现。正在运行的应用还没有重启。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fusionado se ve después de la compilación o el despliegue correspondiente. La app en ejecución no se ha reiniciado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージしたコードは、該当するビルドまたはデプロイの後に反映されます。実行中のアプリは再起動されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código mesclado aparece depois do build ou da implantação correspondente. O app em execução não foi reiniciado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemergter Code wird erst nach dem passenden Build oder Deployment sichtbar. Deine laufende App wurde nicht neu gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code fusionné apparaît après le build ou le déploiement concerné. L’app en cours d’exécution n’a pas été relancée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합된 코드는 해당 빌드나 배포 뒤에 보입니다. 실행 중인 앱은 다시 시작되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слитый код станет виден после соответствующей сборки или развёртывания. Запущенное приложение не перезапускалось."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併的程式碼要在對應的建置或部署之後才會出現。正在執行的 App 還沒有重新啟動。"
          }
        }
      }
    },
    "Merged. Rebuild or deploy the app, then retest.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merged. Rebuild or deploy the app, then retest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已合并。请重新构建或部署应用，然后再测一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionado. Recompila o despliega la app y vuelve a probar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージしました。アプリを再ビルドまたはデプロイしてから再テストしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclado. Recompile ou implante o app e teste de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemergt. Baue die App neu oder deploye sie und teste erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionné. Recompilez ou déployez l’app, puis retestez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합되었습니다. 앱을 다시 빌드하거나 배포한 뒤 재테스트하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слито. Пересоберите или разверните приложение и перепроверьте."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已合併。請重新建置或部署 App，然後再測一次。"
          }
        }
      }
    },
