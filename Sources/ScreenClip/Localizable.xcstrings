    "The key can't contain a line break.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key can't contain a line break."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥不能包含换行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave no puede contener un salto de línea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーに改行は含められません。"
          }
        },
        "pt-BR": {
