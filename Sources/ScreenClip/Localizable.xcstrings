          }
        }
      }
    },
    "Cancel the active ScreenClip run before opening this session in Claude Desktop.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the active ScreenClip run before opening this session in Claude Desktop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude 桌面版中打开此会话前，请先取消正在进行的 ScreenClip 运行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela la ejecución activa de ScreenClip antes de abrir esta sesión en Claude Desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションを Claude デスクトップで開く前に、実行中の ScreenClip の作業をキャンセルしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele a execução ativa do ScreenClip antes de abrir esta sessão no Claude Desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brich den aktiven ScreenClip-Lauf ab, bevor du diese Sitzung in Claude Desktop öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez l’exécution ScreenClip en cours avant d’ouvrir cette session dans Claude Desktop."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션을 Claude 데스크톱에서 열기 전에 진행 중인 ScreenClip 실행을 취소하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмените активный запуск ScreenClip, прежде чем открывать эту сессию в Claude Desktop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude 桌面版中開啟此工作階段前，請先取消進行中的 ScreenClip 執行。"
          }
        }
      }
    },
    "Opened in Claude Desktop. Continue there, and let it finish before ScreenClip runs again.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened in Claude Desktop. Continue there, and let it finish before ScreenClip runs again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Claude 桌面版中打开。请在那里继续，并等它完成后再让 ScreenClip 运行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abierto en Claude Desktop. Continúa allí y deja que termine antes de que ScreenClip vuelva a ejecutarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude デスクトップで開きました。そちらで続け、完了してから ScreenClip を再び実行してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aberto no Claude Desktop. Continue por lá e deixe terminar antes que o ScreenClip execute de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude Desktop geöffnet. Mach dort weiter und lass es fertig werden, bevor ScreenClip wieder läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvert dans Claude Desktop. Continuez là-bas et laissez-le terminer avant que ScreenClip ne s’exécute à nouveau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 데스크톱에서 열었습니다. 거기서 계속하고, 끝난 뒤에 ScreenClip을 다시 실행하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыто в Claude Desktop. Продолжайте там и дождитесь завершения, прежде чем ScreenClip запустится снова."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Claude 桌面版中開啟。請在那裡繼續，並等它完成後再讓 ScreenClip 執行。"
          }
        }
      }
    },
    "Paste the Authorization header value from the Grok Bot routine panel.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the Authorization header value from the Grok Bot routine panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从 Grok Bot 例程面板粘贴 Authorization 标头的值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el valor del encabezado Authorization del panel de la rutina de Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot のルーチンパネルから Authorization ヘッダーの値を貼り付けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o valor do cabeçalho Authorization do painel da rotina do Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Wert des Authorization-Headers aus dem Grok Bot-Routinenbereich ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez la valeur de l’en-tête Authorization depuis le panneau de routine Grok Bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot 루틴 패널에서 Authorization 헤더 값을 붙여 넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте значение заголовка Authorization из панели процедуры Grok Bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從 Grok Bot 例程面板貼上 Authorization 標頭的值。"
          }
        }
      }
    },
    "Paste the Webhook URL and the Authorization header from the Grok Bot routine panel. ScreenClip sends that header value as the HTTP Authorization header and does not add a prefix. Both are stored in the Keychain, not in the queue database.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the Webhook URL and the Authorization header from the Grok Bot routine panel. ScreenClip sends that header value as the HTTP Authorization header and does not add a prefix. Both are stored in the Keychain, not in the queue database."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从 Grok Bot 例程面板粘贴 Webhook URL 和 Authorization 标头。ScreenClip 会原样把该值作为 HTTP Authorization 标头发送，不会加前缀。两者保存在钥匙串中，而不是队列数据库里。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la URL del webhook y el encabezado Authorization del panel de la rutina de Grok Bot. ScreenClip envía ese valor como encabezado HTTP Authorization y no añade un prefijo. Ambos se guardan en el Llavero, no en la base de la cola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot のルーチンパネルから Webhook URL と Authorization ヘッダーを貼り付けてください。ScreenClip はその値を HTTP の Authorization ヘッダーとしてそのまま送り、接頭辞は付けません。どちらもキューのデータベースではなくキーチェーンに保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole a URL do webhook e o cabeçalho Authorization do painel da rotina do Grok Bot. O ScreenClip envia esse valor como cabeçalho HTTP Authorization e não adiciona prefixo. Os dois ficam nas Chaves, não no banco da fila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Webhook-URL und Authorization-Header aus dem Grok Bot-Routinenbereich ein. ScreenClip sendet den Wert unverändert als HTTP-Authorization-Header und setzt kein Präfix davor. Beides liegt im Schlüsselbund, nicht in der Warteschlangen-Datenbank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’URL du webhook et l’en-tête Authorization depuis le panneau de routine Grok Bot. ScreenClip envoie cette valeur telle quelle comme en-tête HTTP Authorization, sans préfixe. Les deux sont stockés dans le Trousseau, pas dans la base de la file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot 루틴 패널에서 Webhook URL과 Authorization 헤더를 붙여 넣으세요. ScreenClip은 그 값을 접두사 없이 HTTP Authorization 헤더로 보냅니다. 둘 다 대기열 데이터베이스가 아니라 키체인에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте URL вебхука и заголовок Authorization из панели процедуры Grok Bot. ScreenClip отправляет это значение как HTTP-заголовок Authorization без префикса. Оба хранятся в Связке ключей, а не в базе очереди."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從 Grok Bot 例程面板貼上 Webhook URL 和 Authorization 標頭。ScreenClip 會原樣把該值作為 HTTP Authorization 標頭傳送，不會加前綴。兩者保存在鑰匙圈中，而不是佇列資料庫裡。"
          }
        }
      }
    },
