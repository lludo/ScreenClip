    "Codex did not enable automatic approval review. Update Codex or choose Ask me in project settings.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex did not enable automatic approval review. Update Codex or choose Ask me in project settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 未启用自动批准审核。请更新 Codex，或在项目设置中选择“询问我”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex no activó la revisión automática de permisos. Actualiza Codex o elige Preguntarme en los ajustes del proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex で承認の自動レビューを有効にできませんでした。Codex を更新するか、プロジェクト設定で「毎回確認」を選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não ativou a revisão automática de permissões. Atualize o Codex ou escolha Perguntar nas configurações do projeto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex hat die automatische Genehmigungsprüfung nicht aktiviert. Aktualisiere Codex oder wähle Mich fragen in den Projekteinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex n’a pas activé la vérification automatique des autorisations. Mettez Codex à jour ou choisissez Me demander dans les réglages du projet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex에서 자동 승인 검토를 활성화하지 못했습니다. Codex를 업데이트하거나 프로젝트 설정에서 직접 확인을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex не включил автоматическую проверку разрешений. Обновите Codex или выберите «Спрашивать меня» в настройках проекта."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 未啟用自動核准審核。請更新 Codex，或在專案設定中選擇「詢問我」。"
          }
        }
      }
    },
