        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連キャプチャは、そのレポートの既存プロジェクトを使う必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas relacionadas precisam usar o projeto já definido no relatório."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugehörige Aufnahmen müssen das bestehende Projekt des Berichts nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures liées doivent utiliser le projet déjà associé au rapport."
