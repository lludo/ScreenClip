    "ios.pair.instructions": {
      "comment": "Pairing instructions. %@ is this Mac's name. Keep ScreenClip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your iPhone or iPad, open the app, shake to open ScreenClip, tap the gear, then tap Pair next to “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 iPad 上打开应用，摇动设备打开 ScreenClip，轻点齿轮图标，然后轻点“%@”旁边的“配对”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu iPhone o iPad, abre la app, agítalo para abrir ScreenClip, toca el engranaje y luego Vincular junto a «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone または iPad でアプリを開き、振って ScreenClip を開いたら、歯車をタップし、「%@」の横の「ペアリング」をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone ou iPad, abra o app, agite para abrir o ScreenClip, toque na engrenagem e depois em Parear ao lado de “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf deinem iPhone oder iPad die App, schüttle es, um ScreenClip zu öffnen, tippe auf das Zahnrad und dann neben „%@“ auf Koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre iPhone ou iPad, ouvrez l’app, secouez pour ouvrir ScreenClip, touchez la roue dentée, puis Jumeler à côté de « %@ »."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad에서 앱을 열고 흔들어 ScreenClip을 연 다음, 톱니바퀴를 탭하고 “%@” 옆의 페어링을 탭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone или iPad откройте приложение, встряхните его, чтобы открыть ScreenClip, нажмите на шестерёнку, затем «Сопрячь» рядом с «%@»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 或 iPad 上開啟 App，搖動裝置開啟 ScreenClip，點一下齒輪，然後點一下「%@」旁的「配對」。"
          }
        }
      }
    },
