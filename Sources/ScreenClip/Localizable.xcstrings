    "ScreenClip is already using this queue. Open the running instance from the menu bar.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip is already using this queue. Open the running instance from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip 已在使用此队列。请从菜单栏打开正在运行的实例。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip ya está usando esta cola. Abre la instancia en ejecución desde la barra de menús."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip はすでにこのキューを使っています。メニューバーから実行中のインスタンスを開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ScreenClip já está usando esta fila. Abra a instância em execução pela barra de menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip nutzt diese Warteschlange bereits. Öffne die laufende Instanz über die Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip utilise déjà cette file. Ouvrez l’instance en cours depuis la barre des menus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip이 이미 이 대기열을 사용 중입니다. 메뉴 막대에서 실행 중인 인스턴스를 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip уже использует эту очередь. Откройте запущенный экземпляр из строки меню."
          }
