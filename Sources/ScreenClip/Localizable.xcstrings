    "ScreenClip is busy with this project. Try the merge again in a moment.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip is busy with this project. Try the merge again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip 正在处理此项目。请稍后再尝试合并。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip está ocupado con este proyecto. Vuelve a intentar la fusión en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip はこのプロジェクトを処理中です。しばらくしてからもう一度マージしてください。"
