    "Drafts cannot be added to a submitted issue. Submit the capture, or choose New issue.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drafts cannot be added to a submitted issue. Submit the capture, or choose New issue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿不能添加到已提交的问题。请提交这次捕获，或选择“新问题”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden añadir borradores a un informe ya enviado. Envía la captura o elige Nuevo informe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済みのレポートに下書きは追加できません。キャプチャを送信するか、「新しいレポート」を選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível adicionar rascunhos a um relatório já enviado. Envie a captura ou escolha Novo relatório."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwürfe können nicht zu einem gesendeten Bericht hinzugefügt werden. Sende die Aufnahme oder wähle „Neuer Bericht“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter un brouillon à un rapport déjà envoyé. Envoyez la capture ou choisissez Nouveau rapport."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 제출한 리포트에는 초안을 추가할 수 없습니다. 캡처를 제출하거나 ‘새 리포트’를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновики нельзя добавлять в отправленный отчёт. Отправьте снимок или выберите «Новый отчёт»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿無法加入已提交的問題。請提交這次擷取，或選擇「新問題」。"
          }
        }
      }
    },
    "This report already has agent work. Use Move to project in the report's menu to continue it under the correct project.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report already has agent work. Use Move to project in the report's menu to continue it under the correct project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此报告已有代理的工作。请在报告菜单中使用“移到项目”，在正确的项目下继续。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe ya tiene trabajo del agente. Usa Mover a un proyecto en el menú del informe para continuarlo en el proyecto correcto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートにはすでにエージェントの作業があります。レポートのメニューの「プロジェクトへ移動」で、正しいプロジェクトに移して続けてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório já tem trabalho do agente. Use Mover para projeto no menu do relatório para continuá-lo no projeto correto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Bericht gibt es bereits Agentenarbeit. Verwende „In Projekt verschieben“ im Menü des Berichts, um ihn im richtigen Projekt fortzusetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport contient déjà du travail de l’agent. Utilisez Déplacer vers un projet dans le menu du rapport pour le poursuivre dans le bon projet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리포트에는 이미 에이전트 작업이 있습니다. 리포트 메뉴의 ‘프로젝트로 이동’을 사용해 올바른 프로젝트에서 계속하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому отчёту агент уже работал. Выберите «Перенести в проект» в меню отчёта, чтобы продолжить в нужном проекте."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此報告已有代理的工作。請在報告選單中使用「移到專案」，在正確的專案下繼續。"
          }
        }
      }
    },
    "This report has a pull request in its current repository. Close or merge it before moving the report.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report has a pull request in its current repository. Close or merge it before moving the report."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此报告在当前仓库中有一个拉取请求。请先关闭或合并它，再移动报告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe tiene una pull request en su repositorio actual. Ciérrala o fusiónala antes de mover el informe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートには現在のリポジトリにプルリクエストがあります。レポートを移す前に、クローズするかマージしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório tem um pull request no repositório atual. Feche-o ou faça o merge antes de mover o relatório."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Bericht gibt es einen Pull Request im aktuellen Repository. Schließe oder merge ihn, bevor du den Bericht verschiebst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport a une pull request dans son dépôt actuel. Fermez-la ou fusionnez-la avant de déplacer le rapport."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리포트에는 현재 저장소에 pull request가 있습니다. 리포트를 옮기기 전에 닫거나 병합하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого отчёта есть pull request в текущем репозитории. Закройте или слейте его перед переносом отчёта."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此報告在目前的儲存庫中有一個拉取請求。請先關閉或合併它，再移動報告。"
          }
        }
      }
    },
    "Connected, but the result could not be saved to the Keychain.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected, but the result could not be saved to the Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，但结果无法保存到钥匙串。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero el resultado no se pudo guardar en el Llavero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しましたが、結果をキーチェーンに保存できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, mas não foi possível salvar o resultado nas Chaves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber das Ergebnis konnte nicht im Schlüsselbund gesichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le résultat n’a pas pu être enregistré dans le Trousseau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되었지만 결과를 키체인에 저장하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено, но результат не удалось сохранить в Связке ключей."
