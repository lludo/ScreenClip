    "Updated the pull request onto the current base branch. Waiting for checks.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated the pull request onto the current base branch. Waiting for checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已把拉取请求更新到当前基线分支。正在等待检查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request se actualizó sobre la rama base actual. Esperando comprobaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プルリクエストを現在のベースブランチに更新しました。チェックを待っています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull request foi atualizado sobre o branch base atual. Aguardando os checks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull Request wurde auf den aktuellen Basis-Branch aktualisiert. Checks stehen aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request a été mise à jour sur la branche de base actuelle. En attente des checks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pull request를 현재 기준 브랜치 위로 업데이트했습니다. 검사를 기다리는 중입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request обновлён на текущую базовую ветку. Ждём проверки."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已把拉取請求更新到目前基底分支。正在等待檢查。"
          }
        }
      }
    },
    "Use Save draft in the capture window to keep your work.": {
      "comment": "Explains how to keep an unsaved capture.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Save draft in the capture window to keep your work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在捕获窗口中使用“保存草稿”以保留你的工作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Guardar borrador en la ventana de captura para conservar el trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業を残すには、キャプチャ画面の「下書きを保存」を使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Salvar rascunho na janela de captura para manter o trabalho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze „Entwurf sichern“ im Aufnahmefenster, um deine Arbeit zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Enregistrer le brouillon dans la fenêtre de capture pour conserver votre travail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 남기려면 캡처 창의 초안 저장을 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сохранить работу, нажмите «Сохранить черновик» в окне захвата."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在擷取視窗中使用「儲存草稿」以保留你的工作。"
          }
        }
      }
    },
    "Use an installed Codex CLI that supports app-server. A detected desktop-bundled runtime can be used for development; it is not redistributed with ScreenClip.": {
      "comment": "Explains the Codex CLI requirement. Keep Codex and app-server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an installed Codex CLI that supports app-server. A detected desktop-bundled runtime can be used for development; it is not redistributed with ScreenClip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用支持 app-server 的已安装 Codex CLI。检测到的桌面捆绑运行时可用于开发，但不会随 ScreenClip 分发。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una CLI de Codex instalada que admita app-server. Un entorno de escritorio detectado puede usarse en desarrollo; no se redistribuye con ScreenClip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "app-server に対応したインストール済みの Codex CLI を使ってください。検出されたデスクトップ同梱ランタイムは開発に使えますが、ScreenClip には同梱しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma CLI do Codex instalada que aceite app-server. Um runtime empacotado com o app de desktop pode ser usado no desenvolvimento; ele não é redistribuído com o ScreenClip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine installierte Codex-CLI mit app-server. Eine erkannte Desktop-Laufzeit kann für die Entwicklung verwendet werden; sie wird nicht mit ScreenClip ausgeliefert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une CLI Codex installée qui prend en charge app-server. Un environnement bureau détecté peut servir au développement ; il n’est pas redistribué avec ScreenClip."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "app-server를 지원하는 설치된 Codex CLI를 사용하세요. 감지된 데스크톱 번들 런타임은 개발에 쓸 수 있으며 ScreenClip과 함께 배포되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте установленную CLI Codex с поддержкой app-server. Обнаруженная среда из настольного приложения годится для разработки и не поставляется вместе со ScreenClip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用支援 app-server 的已安裝 Codex CLI。偵測到的桌面隨附執行環境可用於開發，但不會隨 ScreenClip 散佈。"
          }
        }
      }
    },
    "Use the exact chat created for this issue. ScreenClip will check it before continuing.": {
      "comment": "Explains that the linked chat must belong to this report.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the exact chat created for this issue. ScreenClip will check it before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用为此问题创建的那个聊天。ScreenClip 会在继续前检查它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el chat exacto creado para este informe. ScreenClip lo comprobará antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポート用に作られたチャットをそのまま使ってください。続行前に ScreenClip が確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use exatamente o chat criado para este relatório. O ScreenClip vai verificá-lo antes de continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze genau den Chat, der für diesen Bericht erstellt wurde. ScreenClip prüft ihn, bevor es weitergeht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez exactement le chat créé pour ce rapport. ScreenClip le vérifiera avant de continuer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리포트를 위해 만든 바로 그 채팅을 사용하세요. ScreenClip이 계속하기 전에 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте именно тот чат, который создан для этого отчёта. ScreenClip проверит его перед продолжением."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用為此問題建立的那個聊天。ScreenClip 會在繼續前檢查它。"
