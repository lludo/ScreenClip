    "Saving queues this report with your added context.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving queues this report with your added context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后，这份报告会带着你补充的说明进入队列。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, este informe entra en la cola con el contexto que añadiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、追加した内容とともにこのレポートがキューに入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, este relatório entra na fila com o contexto que você adicionou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern kommt dieser Bericht mit deinem ergänzten Kontext in die Warteschlange."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement met ce rapport en file avec le contexte ajouté."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 추가한 내용과 함께 이 리포트가 대기열에 들어갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение ставит отчёт в очередь вместе с добавленным контекстом."
          }
