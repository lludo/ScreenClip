    "Ask connected devices to send the reports they saved while this Mac was unreachable.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask connected devices to send the reports they saved while this Mac was unreachable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让已连接的设备发送在此 Mac 无法访问时保存的报告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a los dispositivos conectados que envíen los informes que guardaron mientras este Mac no estaba disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac に接続できなかった間に保存されたレポートを、接続中のデバイスに送信させます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede aos dispositivos conectados que enviem os relatórios salvos enquanto este Mac estava inacessível."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet verbundene Geräte, die Berichte zu senden, die sie gespeichert haben, während dieser Mac nicht erreichbar war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande aux appareils connectés d’envoyer les rapports enregistrés pendant que ce Mac était injoignable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 연결할 수 없는 동안 저장된 리포트를 연결된 기기에서 보내도록 요청합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросить подключённые устройства отправить отчёты, сохранённые, пока этот Mac был недоступен."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求已連線的裝置傳送在此 Mac 無法連線時儲存的報告。"
          }
        }
      }
    },
    "Import report file…": {
      "comment": "Imports a report file exported from an iOS device.",
      "extractionState": "manual",
