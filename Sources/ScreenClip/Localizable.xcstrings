    "Codex is told you are not available: questions get the safest default and permissions are declined.": {
      "comment": "Explains the setting for unanswered Codex requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex is told you are not available: questions get the safest default and permissions are declined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 会被告知你不在：问题采用最稳妥的默认值，权限请求会被拒绝。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se indica a Codex que no estás disponible: las preguntas reciben la opción más segura y los permisos se rechazan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex には不在であることが伝えられます。質問には最も安全な既定値が使われ、権限のリクエストは拒否されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex é informado de que você não está disponível: as perguntas recebem a opção mais segura e as permissões são recusadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex erfährt, dass du nicht verfügbar bist: Fragen erhalten die sicherste Standardantwort, Berechtigungen werden abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex est informé que vous n’êtes pas disponible : les questions reçoivent le choix le plus sûr et les autorisations sont refusées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex에 사용자가 자리에 없다고 알립니다. 질문에는 가장 안전한 기본값이 쓰이고 권한 요청은 거부됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex узнаёт, что вас нет: на вопросы даётся самый безопасный вариант, а разрешения отклоняются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 會被告知你不在：問題採用最穩妥的預設值，權限請求會被拒絕。"
          }
        }
      }
    },
    "Not validated on this Mac: validation of Grok Bot pull requests runs only with automatic merge on.": {
