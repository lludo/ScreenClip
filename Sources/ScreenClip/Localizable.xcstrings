    "Authenticate GitHub CLI with gh auth login. Fixes are published from isolated branches; project checks and required reviews govern automatic merge.": {
      "comment": "Explains GitHub CLI setup. Keep gh auth login.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticate GitHub CLI with gh auth login. Fixes are published from isolated branches; project checks and required reviews govern automatic merge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 gh auth login 登录 GitHub CLI。修复从隔离分支发布；项目检查和必需的审查决定是否自动合并。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentica GitHub CLI con gh auth login. Las correcciones se publican desde ramas aisladas; las comprobaciones y las revisiones obligatorias deciden la fusión automática."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gh auth login で GitHub CLI にログインします。修正は隔離ブランチから公開され、プロジェクトのチェックと必須レビューが自動マージを決めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentique o GitHub CLI com gh auth login. As correções saem de branches isolados; os checks e as revisões obrigatórias decidem o merge automático."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde die GitHub CLI mit gh auth login an. Fixes werden von isolierten Branches veröffentlicht; Projekt-Checks und erforderliche Reviews steuern den automatischen Merge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez GitHub CLI avec gh auth login. Les correctifs partent de branches isolées ; les checks et les revues requises décident de la fusion automatique."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "gh auth login으로 GitHub CLI에 로그인합니다. 수정은 격리된 브랜치에서 게시되며, 프로젝트 검사와 필수 리뷰가 자동 병합을 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в GitHub CLI через gh auth login. Исправления публикуются из изолированных веток; проверки и обязательные ревью решают автослияние."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 gh auth login 登入 GitHub CLI。修復從隔離分支發布；專案檢查和必要審查決定是否自動合併。"
          }
        }
      }
    },
