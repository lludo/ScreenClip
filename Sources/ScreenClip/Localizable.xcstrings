          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde nicht abgeschlossen. Prüfe die Verbindung, wenn der Browser einen Fehler zeigte, oder melde dich mit einem Code an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ne s’est pas terminée. Vérifiez la connexion si le navigateur a affiché une erreur, ou essayez un code."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 끝나지 않았습니다. 브라우저에 오류가 보이면 연결을 확인하거나 코드로 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не завершился. Если браузер показал ошибку, проверьте подключение или войдите с кодом."
          }
        },
        "zh-Hant": {
          "stringUnit": {
