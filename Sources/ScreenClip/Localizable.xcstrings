    "The conversation is in Grok Bot's chat. ScreenClip cannot open or reconcile it from here.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation is in Grok Bot's chat. ScreenClip cannot open or reconcile it from here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话在 Grok Bot 的聊天中。ScreenClip 无法从这里打开或核对它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación está en el chat de Grok Bot. ScreenClip no puede abrirla ni reconciliarla desde aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話は Grok Bot のチャットにあります。ScreenClip からは開けず、照合もできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa está no chat do Grok Bot. O ScreenClip não consegue abri-la nem reconciliá-la daqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gespräch liegt im Chat von Grok Bot. ScreenClip kann es von hier aus nicht öffnen oder abgleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation est dans le chat de Grok Bot. ScreenClip ne peut ni l’ouvrir ni la rapprocher depuis ici."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화는 Grok Bot 채팅에 있습니다. ScreenClip은 여기서 열거나 맞출 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговор в чате Grok Bot. ScreenClip не может открыть или сверить его отсюда."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話在 Grok Bot 的聊天中。ScreenClip 無法從這裡開啟或核對它。"
          }
        }
      }
    },
