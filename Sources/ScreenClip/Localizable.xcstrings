    "In Grok Bot, open your ScreenClip assistant's info pane, open the ScreenClip reports routine, and copy these two values.": {
      "comment": "Where to copy the Grok Bot webhook. Keep ScreenClip, Grok Bot, and ScreenClip reports.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Grok Bot, open your ScreenClip assistant's info pane, open the ScreenClip reports routine, and copy these two values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Grok Bot 中，打开你的 ScreenClip 助手的信息面板，打开 ScreenClip reports 例程，并复制这两个值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Grok Bot, abre el panel de información de tu asistente de ScreenClip, abre la rutina ScreenClip reports y copia estos dos valores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot で ScreenClip アシスタントの情報ペインを開き、ScreenClip reports ルーチンを開いて、この 2 つの値をコピーしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Grok Bot, abra o painel de informações do seu assistente do ScreenClip, abra a rotina ScreenClip reports e copie estes dois valores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Grok Bot den Infobereich deines ScreenClip-Assistenten, öffne die Routine ScreenClip reports und kopiere diese beiden Werte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Grok Bot, ouvrez le volet d’informations de votre assistant ScreenClip, ouvrez la routine ScreenClip reports et copiez ces deux valeurs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot에서 ScreenClip 도우미의 정보 패널을 열고 ScreenClip reports 루틴을 연 다음 이 두 값을 복사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Grok Bot откройте панель сведений помощника ScreenClip, откройте процедуру ScreenClip reports и скопируйте эти два значения."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Grok Bot 中，打開你的 ScreenClip 助手的資訊面板，打開 ScreenClip reports 例程，並複製這兩個值。"
          }
        }
      }
    },
