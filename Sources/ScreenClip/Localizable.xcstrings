    "Keep this Mac awake while receiving iOS reports": {
      "comment": "Prevents idle sleep while the iOS local server is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this Mac awake while receiving iOS reports"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收 iOS 报告时让此 Mac 保持唤醒"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener este Mac activo mientras recibe informes de iOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS レポートを受信する間、この Mac をスリープさせない"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
