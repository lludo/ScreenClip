    "ScreenClip checks for a new version once a day. A downloaded update installs the next time ScreenClip quits.": {
      "comment": "Explains automatic updates. Keep ScreenClip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip checks for a new version once a day. A downloaded update installs the next time ScreenClip quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip 每天检查一次新版本。下载的更新会在下次退出 ScreenClip 时安装。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip busca una versión nueva una vez al día. Una actualización descargada se instala la próxima vez que salgas de ScreenClip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip は 1 日に 1 回新しいバージョンを確認します。ダウンロードしたアップデートは、次に ScreenClip を終了したときにインストールされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ScreenClip procura uma nova versão uma vez por dia. Uma atualização baixada é instalada na próxima vez que você encerrar o ScreenClip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip sucht einmal täglich nach einer neuen Version. Ein geladenes Update wird beim nächsten Beenden von ScreenClip installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip recherche une nouvelle version une fois par jour. Une mise à jour téléchargée s’installe la prochaine fois que vous quittez ScreenClip."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip은 하루에 한 번 새 버전을 확인합니다. 다운로드한 업데이트는 다음에 ScreenClip을 종료할 때 설치됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip проверяет наличие новой версии раз в день. Загруженное обновление устанавливается при следующем выходе из ScreenClip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip 每天檢查一次新版本。下載的更新會在下次結束 ScreenClip 時安裝。"
          }
        }
      }
    },
