          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluez le schéma et le port, par exemple http://localhost:3000 ou https://example.com/app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킴과 포트를 포함하세요. 예: http://localhost:3000 또는 https://example.com/app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
