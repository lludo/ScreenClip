    "This command runs in the issue's worktree before publishing. Automatic merge also requires passing GitHub checks and required reviews.": {
      "comment": "Explains validation. Keep GitHub.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This command runs in the issue's worktree before publishing. Automatic merge also requires passing GitHub checks and required reviews."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此命令会在发布前于该问题的工作区中运行。自动合并还要求通过 GitHub 检查和必需的审查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando se ejecuta en el worktree del informe antes de publicar. La fusión automática también exige superar las comprobaciones de GitHub y las revisiones obligatorias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコマンドは公開前にレポートの worktree で実行されます。自動マージには GitHub のチェックと必須レビューの通過も必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando roda no worktree do relatório antes da publicação. O merge automático também exige passar nos checks do GitHub e nas revisões obrigatórias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Befehl läuft vor der Veröffentlichung im Worktree des Berichts. Automatisches Mergen verlangt zusätzlich bestandene GitHub-Checks und erforderliche Reviews."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette commande s’exécute dans le worktree du rapport avant publication. La fusion automatique exige aussi des checks GitHub et des revues requises réussis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명령은 게시 전에 리포트 worktree에서 실행됩니다. 자동 병합에는 GitHub 검사와 필수 리뷰 통과도 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта команда выполняется в рабочей копии отчёта перед публикацией. Автослияние также требует проверок GitHub и обязательных ревью."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此命令會在發布前於該問題的工作區中執行。自動合併還要求通過 GitHub 檢查和必要審查。"
          }
        }
      }
    },
    "This project has recorded issues. Add a new project to use a different repository.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project has recorded issues. Add a new project to use a different repository."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目已有记录的问题。要使用另一个仓库，请添加新项目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto ya tiene informes. Añade un proyecto nuevo para usar otro repositorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトには記録済みのレポートがあります。別のリポジトリを使うには、新しいプロジェクトを追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este projeto já tem relatórios. Adicione um projeto novo para usar outro repositório."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt hat bereits Berichte. Füge ein neues Projekt hinzu, um ein anderes Repository zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet a déjà des rapports. Ajoutez un nouveau projet pour utiliser un autre dépôt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트에는 기록된 리포트가 있습니다. 다른 저장소를 쓰려면 새 프로젝트를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого проекта уже есть отчёты. Добавьте новый проект, чтобы использовать другой репозиторий."
          }
