    "ScreenClip restarted while sending to Grok Bot. Retry delivers the same report and revision again.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip restarted while sending to Grok Bot. Retry delivers the same report and revision again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到 Grok Bot 时 ScreenClip 重启了。重试会再次发送同一份报告和同一修订。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip se reinició mientras enviaba a Grok Bot. Reintentar entrega otra vez el mismo informe y la misma revisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot への送信中に ScreenClip が再起動しました。再試行は同じレポートと同じリビジョンを再び届けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ScreenClip reiniciou ao enviar para o Grok Bot. Tentar de novo entrega o mesmo relatório e a mesma revisão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip wurde während des Sendens an Grok Bot neu gestartet. Ein erneuter Versuch liefert denselben Bericht und dieselbe Revision noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenClip a redémarré pendant l’envoi à Grok Bot. Réessayer renvoie le même rapport et la même révision."
          }
