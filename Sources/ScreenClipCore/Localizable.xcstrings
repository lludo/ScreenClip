          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル済み"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소됨"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменён"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        }
      }
    },
    "Canceled locally. Grok Bot cannot be stopped from ScreenClip; it may still finish and open a pull request.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canceled locally. Grok Bot cannot be stopped from ScreenClip; it may still finish and open a pull request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本地取消。ScreenClip 无法停止 Grok Bot；它仍可能完成并打开拉取请求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado en local. ScreenClip no puede detener a Grok Bot; aún puede terminar y abrir una pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルではキャンセルしました。ScreenClip から Grok Bot は止められず、完了してプルリクエストを開くことがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado localmente. O ScreenClip não consegue parar o Grok Bot; ele ainda pode concluir e abrir um pull request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal abgebrochen. ScreenClip kann Grok Bot nicht stoppen; er kann trotzdem fertig werden und einen Pull Request öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé localement. ScreenClip ne peut pas arrêter Grok Bot ; il peut encore terminer et ouvrir une pull request."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에서 취소했습니다. ScreenClip은 Grok Bot을 멈출 수 없으며, 작업을 끝내고 pull request를 열 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменено локально. ScreenClip не может остановить Grok Bot; он всё ещё может закончить и открыть pull request."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本機取消。ScreenClip 無法停止 Grok Bot；它仍可能完成並開啟拉取請求。"
          }
        }
      }
    },
    "Cannot prepare queue save.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot prepare queue save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备队列保存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede preparar el guardado de la cola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューの保存を準備できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar o salvamento da fila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange kann nicht zum Speichern vorbereitet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer l’enregistrement de la file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열 저장을 준비할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить сохранение очереди."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備佇列儲存。"
          }
        }
      }
    },
    "Cannot read the queue.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the queue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取队列。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la cola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを読み取れません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a fila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange kann nicht gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열을 읽을 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать очередь."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取佇列。"
          }
        }
      }
    },
    "Choose a project that allows sending screenshots to Grok Bot.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a project that allows sending screenshots to Grok Bot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择允许向 Grok Bot 发送截图的项目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un proyecto que permita enviar capturas a Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot へのスクリーンショット送信を許可したプロジェクトを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um projeto que permita enviar capturas ao Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Projekt, das Screenshots an Grok Bot senden darf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un projet qui autorise l’envoi de captures à Grok Bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot으로 스크린샷을 보낼 수 있는 프로젝트를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите проект, которому разрешена отправка снимков в Grok Bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇允許向 Grok Bot 傳送截圖的專案。"
          }
        }
      }
    },
    "Choose a working Claude Code executable in Settings.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a working Claude Code executable in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中选择可用的 Claude Code 可执行文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un ejecutable de Claude Code que funcione en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で動作する Claude Code 実行ファイルを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um executável funcional do Claude Code em Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in den Einstellungen eine funktionierende Claude Code-Programmdatei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un exécutable Claude Code utilisable dans Réglages."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 동작하는 Claude Code 실행 파일을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите рабочий исполняемый файл Claude Code в Настройках."
