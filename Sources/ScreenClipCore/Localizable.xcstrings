    "Choose a project that can share screenshots with Grok Bot.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a project that can share screenshots with Grok Bot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个可以向 Grok Bot 共享截图的项目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un proyecto que pueda compartir capturas con Grok Bot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot とスクリーンショットを共有できるプロジェクトを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um projeto que possa compartilhar capturas com o Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Projekt, das Screenshots mit Grok Bot teilen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un projet qui peut partager des captures avec Grok Bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot과 스크린샷을 공유할 수 있는 프로젝트를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите проект, который может делиться снимками с Grok Bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一個可以向 Grok Bot 共享截圖的專案。"
          }
        }
      }
    },
    "Turn on sharing screenshots with Grok Bot for this project. Approved annotated screenshots are pushed to a branch in the project's GitHub repo.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on sharing screenshots with Grok Bot for this project. Approved annotated screenshots are pushed to a branch in the project's GitHub repo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为此项目打开与 Grok Bot 共享截图。已批准的带标注截图会推送到该项目 GitHub 仓库的一个分支。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el envío de capturas a Grok Bot para este proyecto. Las capturas anotadas aprobadas se envían a una rama del repositorio de GitHub del proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトで Grok Bot とのスクリーンショット共有をオンにしてください。承認された注釈付きスクリーンショットは、プロジェクトの GitHub リポジトリのブランチにプッシュされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o compartilhamento de capturas com o Grok Bot neste projeto. Capturas anotadas aprovadas vão para um branch do repositório GitHub do projeto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte für dieses Projekt das Teilen von Screenshots mit Grok Bot ein. Freigegebene, kommentierte Screenshots werden in einen Branch des GitHub-Repos des Projekts gepusht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le partage de captures avec Grok Bot pour ce projet. Les captures annotées approuvées sont poussées vers une branche du dépôt GitHub du projet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트에서 Grok Bot과 스크린샷 공유를 켜세요. 승인된 주석 스크린샷은 프로젝트 GitHub 저장소의 브랜치로 푸시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите для этого проекта отправку снимков в Grok Bot. Одобренные снимки с пометками отправляются в ветку репозитория GitHub проекта."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為此專案開啟與 Grok Bot 共享截圖。已核准的帶標註截圖會推送到該專案 GitHub 倉庫的一個分支。"
          }
        }
      }
    },
    "Paste the setup code Grok Bot gave you.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
