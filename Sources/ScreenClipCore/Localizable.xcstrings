          "stringUnit": {
            "state": "translated",
            "value": "Turn on Allow sending screenshots to the external assistant for this project before choosing Grok Bot. Approved screenshots are pushed to a screenclip/ branch in the project's repository."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Grok Bot 前，请为此项目打开“允许向外部助手发送截图”。已批准的截图会被推送到项目仓库的 screenclip/ 分支。"
