          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot にキャプチャを送る前に、このプロジェクトの設定で外部アシスタントへのスクリーンショット送信を許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Permitir envio de capturas ao assistente externo nas configurações deste projeto antes de enviar capturas ao Grok Bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte in den Einstellungen dieses Projekts das Senden von Screenshots an den externen Assistenten ein, bevor du Aufnahmen an Grok Bot schickst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’envoi de captures à l’assistant externe dans les réglages de ce projet avant d’envoyer des captures à Grok Bot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot에 캡처를 보내기 전에 이 프로젝트 설정에서 외부 도우미로 스크린샷 보내기를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой снимков в Grok Bot включите отправку снимков внешнему ассистенту в настройках этого проекта."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Grok Bot 傳送擷取前，請在此專案的設定中開啟「允許向外部助手傳送截圖」。"
          }
        }
      }
    },
