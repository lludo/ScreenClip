        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューを読み取れません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a fila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange kann nicht gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열을 읽을 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать очередь."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取佇列。"
          }
        }
      }
    },
    "Choose a working Claude Code executable in Settings.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a working Claude Code executable in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中选择可用的 Claude Code 可执行文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un ejecutable de Claude Code que funcione en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で動作する Claude Code 実行ファイルを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um executável funcional do Claude Code em Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in den Einstellungen eine funktionierende Claude Code-Programmdatei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un exécutable Claude Code utilisable dans Réglages."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 동작하는 Claude Code 실행 파일을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите рабочий исполняемый файл Claude Code в Настройках."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在設定中選擇可用的 Claude Code 執行檔。"
          }
        }
      }
    },
