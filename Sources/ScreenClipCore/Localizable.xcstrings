          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ из процедуры ScreenClip reports."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 ScreenClip reports 例程中的金鑰。"
          }
        }
      }
    },
    "The Webhook URL has to start with https.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Webhook URL has to start with https."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook URL 必须以 https 开头。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del webhook tiene que empezar por https."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook URL は https で始まる必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL do webhook precisa começar com https."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Webhook-URL muss mit https beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du webhook doit commencer par https."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook URL은 https로 시작해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL вебхука должен начинаться с https."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook URL 必須以 https 開頭。"
          }
        }
      }
    },
    "The key can't contain a line break.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key can't contain a line break."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥不能包含换行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave no puede contener un salto de línea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーに改行は含められません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave não pode ter uma quebra de linha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel darf keinen Zeilenumbruch enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé ne peut pas contenir de saut de ligne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키에는 줄바꿈이 들어갈 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не может содержать перевод строки."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰不能包含換行。"
          }
        }
      }
    },
    "Cancel requested. This is best-effort: Grok Bot may still finish work it already started.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel requested. This is best-effort: Grok Bot may still finish work it already started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求取消。这只是尽力而为：Grok Bot 仍可能完成已经开始的工作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelación solicitada. Es un intento: Grok Bot aún puede terminar el trabajo que ya empezó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルを依頼しました。ベストエフォートです。Grok Bot はすでに始めた作業を終えることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelamento solicitado. É o melhor esforço: o Grok Bot ainda pode concluir o trabalho já iniciado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbruch angefordert. Das ist ein Best-Effort: Grok Bot kann bereits begonnene Arbeit trotzdem abschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation demandée. C’est un effort au mieux : Grok Bot peut encore terminer un travail déjà commencé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소를 요청했습니다. 최선의 시도입니다. Grok Bot은 이미 시작한 작업을 끝낼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрошена отмена. Это лучшее усилие: Grok Bot может всё же закончить уже начатую работу."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求取消。這只是盡力而為：Grok Bot 仍可能完成已經開始的工作。"
          }
        }
      }
    },
    "Could not reach Grok Bot to ask it to stop.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Grok Bot to ask it to stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连上 Grok Bot 以请求停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con Grok Bot para pedirle que se detenga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止を頼むために Grok Bot へ到達できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o Grok Bot para pedir que pare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot war nicht erreichbar, um einen Stopp zu bitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Grok Bot pour lui demander d’arrêter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지를 요청하려고 Grok Bot에 연결하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с Grok Bot, чтобы попросить остановиться."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上 Grok Bot 以要求停止。"
          }
        }
      }
    },
    "Draft PR. Automatic merge waits until the pull request is marked ready.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft PR. Automatic merge waits until the pull request is marked ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿 PR。自动合并会等到拉取请求被标为可合并。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PR en borrador. La fusión automática espera a que la pull request se marque como lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラフト PR。pull request が準備完了になるまで自動マージは待ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PR em rascunho. A mesclagem automática espera o pull request ser marcado como pronto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PR-Entwurf. Die automatische Zusammenführung wartet, bis der Pull Request als bereit markiert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PR en brouillon. La fusion automatique attend que la pull request soit marquée prête."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안 PR. pull request가 준비됨으로 표시될 때까지 자동 병합은 기다립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик PR. Автоматическое слияние ждёт, пока pull request не будет отмечен готовым."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿 PR。自動合併會等到拉取請求被標為可合併。"
          }
        }
      }
    },
