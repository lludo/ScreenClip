    "Not connected — Connect Grok Bot. The address has to start with https, and the secret can't contain a line break.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected — Connect Grok Bot. The address has to start with https, and the secret can't contain a line break."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接 — 连接 Grok Bot。地址必须以 https 开头，密钥不能包含换行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conectado — Conectar Grok Bot. La dirección tiene que empezar por https y el secreto no puede contener un salto de línea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未接続 — Grok Bot に接続。アドレスは https で始まり、シークレットに改行を含められません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conectado — Conectar o Grok Bot. O endereço precisa começar com https, e o segredo não pode ter uma quebra de linha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verbunden — Grok Bot verbinden. Die Adresse muss mit https beginnen, und das Geheimnis darf keinen Zeilenumbruch enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté — Connecter Grok Bot. L’adresse doit commencer par https, et le secret ne peut pas contenir de saut de ligne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 안 됨 — Grok Bot 연결. 주소는 https로 시작해야 하고 비밀에는 줄바꿈이 들어갈 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подключено — Подключить Grok Bot. Адрес должен начинаться с https, а секрет не может содержать перевод строки."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連線 — 連接 Grok Bot。位址必須以 https 開頭，密鑰不能包含換行。"
          }
        }
      }
    },
