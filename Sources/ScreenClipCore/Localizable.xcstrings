    "Not configured. Add the webhook URL and Authorization header in Settings → Connections → External assistant.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not configured. Add the webhook URL and Authorization header in Settings → Connections → External assistant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置。请在“设置 → 连接 → 外部助手”中添加 Webhook URL 和 Authorization 标头。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No configurado. Añade la URL del webhook y el encabezado Authorization en Ajustes → Conexiones → Asistente externo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定です。設定 → 接続 → 外部アシスタントで Webhook URL と Authorization ヘッダーを追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não configurado. Adicione a URL do webhook e o cabeçalho Authorization em Ajustes → Conexões → Assistente externo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht konfiguriert. Füge Webhook-URL und Authorization-Header unter Einstellungen → Verbindungen → Externer Assistent hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non configuré. Ajoutez l’URL du webhook et l’en-tête Authorization dans Réglages → Connexions → Assistant externe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성되지 않았습니다. 설정 → 연결 → 외부 도우미에서 Webhook URL과 Authorization 헤더를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не настроено. Добавьте URL вебхука и заголовок Authorization в Настройки → Подключения → Внешний ассистент."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定。請在「設定 → 連線 → 外部助手」中加入 Webhook URL 和 Authorization 標頭。"
          }
        }
      }
    },
    "Not configured. The webhook URL must be an http or https address, and the Authorization header value is required. Edit them in Settings → Connections → External assistant.": {
      "comment": "ScreenClip interface text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not configured. The webhook URL must be an http or https address, and the Authorization header value is required. Edit them in Settings → Connections → External assistant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置。Webhook URL 必须是 http 或 https 地址，并且必须填写 Authorization 标头。请在“设置 → 连接 → 外部助手”中修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No configurado. La URL del webhook debe ser http o https, y el encabezado Authorization es obligatorio. Edítalos en Ajustes → Conexiones → Asistente externo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定です。Webhook URL は http または https で、Authorization ヘッダーの値も必要です。設定 → 接続 → 外部アシスタントで編集してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não configurado. A URL do webhook precisa ser http ou https, e o valor do cabeçalho Authorization é obrigatório. Edite em Ajustes → Conexões → Assistente externo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht konfiguriert. Die Webhook-URL muss http oder https sein, und der Authorization-Header ist erforderlich. Bearbeite beides unter Einstellungen → Verbindungen → Externer Assistent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non configuré. L’URL du webhook doit être en http ou https, et la valeur de l’en-tête Authorization est requise. Modifiez-les dans Réglages → Connexions → Assistant externe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성되지 않았습니다. Webhook URL은 http 또는 https여야 하고 Authorization 헤더 값이 필요합니다. 설정 → 연결 → 외부 도우미에서 수정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не настроено. URL вебхука должен быть http или https, и нужен заголовок Authorization. Измените их в Настройки → Подключения → Внешний ассистент."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定。Webhook URL 必須是 http 或 https 位址，並且必須填寫 Authorization 標頭。請在「設定 → 連線 → 外部助手」中修改。"
          }
        }
      }
    },
